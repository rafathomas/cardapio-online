###############################################################################
# APP
###############################################################################
APP_NAME="Cardapio Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

###############################################################################
# LOG
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# DATABASE
###############################################################################
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cardapio
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=3306

# Base usada pela suite automatizada (criada pelo Sail automaticamente).
DB_TEST_DATABASE=testing

###############################################################################
# SESSION / CACHE / QUEUE
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=

QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

###############################################################################
# AUTENTICACAO / SANCTUM
###############################################################################
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,localhost:5173,127.0.0.1,127.0.0.1:8000,::1

###############################################################################
# STORAGE
###############################################################################
FILESYSTEM_DISK=public
# Tamanho maximo de upload de imagem em kilobytes.
UPLOAD_MAX_IMAGE_KB=4096
# Largura maxima (px) para redimensionamento automatico de imagens enviadas.
UPLOAD_IMAGE_MAX_WIDTH=1280

###############################################################################
# MAIL
###############################################################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@cardapio.test"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# MERCADO PAGO
# Nunca versionar credenciais reais. Use as chaves de teste em desenvolvimento.
###############################################################################
PAYMENT_GATEWAY=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_STATEMENT_DESCRIPTOR="CARDAPIO"
MERCADOPAGO_TIMEOUT=15
# URL publica que o Mercado Pago chamara. Em desenvolvimento use um tunel (ngrok, expose).
MERCADOPAGO_NOTIFICATION_URL="${APP_URL}/webhooks/mercadopago"
MERCADOPAGO_SUCCESS_URL="${APP_URL}/app/assinatura/retorno?status=success"
MERCADOPAGO_PENDING_URL="${APP_URL}/app/assinatura/retorno?status=pending"
MERCADOPAGO_FAILURE_URL="${APP_URL}/app/assinatura/retorno?status=failure"
# Valida a assinatura x-signature do webhook. Mantenha true em producao.
MERCADOPAGO_VERIFY_SIGNATURE=true

###############################################################################
# WHATSAPP
###############################################################################
WHATSAPP_BASE_URL=https://wa.me
WHATSAPP_DEFAULT_COUNTRY_CODE=55

###############################################################################
# VITE
###############################################################################
VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173
